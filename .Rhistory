x = nrow(df_sci_mixed) + 10, y = 0.07,
hjust = 0, size = 3.5, color = "#C97C5D",
label = paste0("Current n = ", nrow(df_sci_mixed))) +
annotate("text",
x = max(n_values) * 0.97, y = 0.82,
hjust = 1, size = 3.5, color = "grey40",
label = "80% power") +
# Mark the n needed for 80% power if within range
{if (!is.na(n_80) && n_80 <= max(n_values))
geom_vline(xintercept = n_80, linetype = "dotted", color = "grey40")
} +
scale_y_continuous(limits = c(0, 1),
labels = scales::percent_format(accuracy = 1),
breaks = seq(0, 1, 0.2)) +
scale_x_continuous(breaks = n_values) +
labs(
x        = "Number of species in within-genus dataset",
y        = "Simulated power",
title    = "Power analysis: within-genus SCI comparison",
subtitle = paste0(
"Effect size from Model 7 (\u03b2 \u2248 \u22120.28 on logit scale). ",
"500 simulations per n, \u03b1 = 0.05.\n",
"Model: logit(SCI) ~ epiphyte_label + (1 | family/genus), lme4."
)
) +
theme_classic(base_size = 14) +
theme(
axis.text    = element_text(color = "black"),
plot.subtitle = element_text(size = 9, color = "grey30"),
axis.text.x  = element_text(angle = 30, hjust = 1)
)
ggsave("figS2-power-analysis.pdf", width = 9, height = 6)
ggsave("figS2-power-analysis.svg", width = 9, height = 6)
cat("\nPower curve saved.\n")
