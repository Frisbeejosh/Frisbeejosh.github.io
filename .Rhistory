focus_dat <- raw_data |>
filter(
species %in% c("c_nut", "c_sess"),
!is.na(longest_leaf_length),
!is.na(num_fruits_flowers)
) |>
mutate(
species = factor(species, levels = c("c_nut", "c_sess")),
shape_group = case_when(
species == "c_nut"              ~ "nutans",
sex == "staminate"             ~ "sessiliflora_staminate",
sex == "pistillate"            ~ "sessiliflora_pistillate",
TRUE                           ~ "sessiliflora_other"
)
)
fig1 <- ggplot(focus_dat,
aes(x = longest_leaf_length,
y = num_fruits_flowers,
color = species,
shape = shape_group)) +
geom_point(alpha = 0.65, size = 2.5) +
geom_line(
data = pred_species,
aes(y = fit),
linewidth = 1.2
) +
scale_y_log10() +
scale_color_manual(
values = species_cols,
labels = species_labs
) +
scale_shape_manual(
values = c(
"nutans"                  = 16,  # filled circle
"sessiliflora_staminate"  = 17,  # filled triangle
"sessiliflora_pistillate" = 15,  # filled square
"sessiliflora_other"      = 16   # fallback circle
),
guide = "none"  # remove shape legend if you want color legend only
) +
labs(
x = "Longest leaf length (cm)",
y = "Reproductive units (log scale)",
color = "Species"
) +
theme_bw(base_size = 18) +
theme(panel.grid.minor = element_blank())
fig1
