# Numeric summary
summary_table <- raw_data |>
filter(species %in% c("c_nut", "c_sess")) |>
mutate(sex = ifelse(is.na(sex) | sex == "", "unknown", sex)) |>
group_by(species, sex) |>
summarise(
across(
all_of(numeric_traits),
list(
mean = ~round(mean(.x, na.rm = TRUE), 2),
min  = ~round(min(.x, na.rm = TRUE), 2),
max  = ~round(max(.x, na.rm = TRUE), 2),
n    = ~sum(!is.na(.x))
)
),
.groups = "drop"
)
# Branching frequency table separately
branching_summary <- raw_data |>
filter(species %in% c("c_nut", "c_sess")) |>
mutate(sex = ifelse(is.na(sex) | sex == "", "unknown", sex)) |>
count(species, sex, inflorescence_branched_unbranched) |>
group_by(species, sex) |>
mutate(prop = round(n / sum(n), 2)) |>
ungroup()
print(summary_table, n = Inf)
print(branching_summary)
write.csv(summary_table, "traits-table1_summary.csv", row.names = FALSE)
write.csv(branching_summary, "branching-table1_summary.csv", row.names = FALSE)
focus_dat <- raw_data |>
filter(
species %in% c("c_nut", "c_sess"),
!is.na(longest_leaf_length),
!is.na(num_fruits_flowers)
) |>
mutate(species = factor(species, levels = c("c_nut", "c_sess")))
# Model
m_species <- glmmTMB(
num_fruits_flowers ~ longest_leaf_length + species,
family = nbinom2,
data = focus_dat
)
# Prediction grid
pred_species <- expand.grid(
longest_leaf_length = seq(
min(focus_dat$longest_leaf_length, na.rm = TRUE),
max(focus_dat$longest_leaf_length, na.rm = TRUE),
length.out = 100
),
species = levels(focus_dat$species)
) |>
mutate(fit = predict(m_species, newdata = pick(everything()), type = "response"))
# Plot
fig1 <- ggplot(focus_dat,
aes(x = longest_leaf_length,
y = num_fruits_flowers,
color = species)) +
geom_point(alpha = 0.65, size = 2.5) +
geom_line(
data = pred_species,
aes(y = fit),
linewidth = 1.2
) +
scale_y_log10() +
scale_color_manual(
values = species_cols,
labels = species_labs
) +
labs(
x = "Longest leaf length (cm)",
y = "Reproductive units (log scale)",
color = "Species"
) +
theme_bw(base_size = 18) +
theme(panel.grid.minor = element_blank())
