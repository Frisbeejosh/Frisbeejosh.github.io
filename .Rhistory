traits <- c("longest_leaf_length", "vegetative_diameter", "pup_number",
"num_fruits_flowers", "inflorescence_length",
"inflorescence_branched_unbranched", "num_branches")
summary_table <- raw_data |>
filter(species %in% c("c_nut", "c_sess")) |>
mutate(sex = ifelse(is.na(sex) | sex == "", "hermaphrodite", sex)) |>
group_by(species, sex) |>
summarise(
across(
all_of(traits),
list(
mean = ~round(mean(.x, na.rm = TRUE), 2),
min  = ~round(min(.x, na.rm = TRUE), 2),
max  = ~round(max(.x, na.rm = TRUE), 2),
n    = ~sum(!is.na(.x))
)
),
.groups = "drop"
)
